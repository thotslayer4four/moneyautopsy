# LLM (optional in development — without a key, the app falls back to a deterministic
# mock insight generator built from the same real analysis numbers, see src/lib/llm/mock.ts)
# LLM_PROVIDER picks explicitly ("anthropic" | "groq" | "zai" | "mock"); left unset, it
# uses the first configured key in that order, else mock.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flash

# Payments — defaults to "mock" outside production so the paywall flow is testable
# without real keys. Set to "paystack" (and provide the keys below) to use real payments.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/report
